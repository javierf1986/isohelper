# Environment Configuration
# Copy this file to .env and update with your actual values

# Application Settings
ENVIRONMENT=development
DEBUG=True

# API Configuration
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# AI Configuration
# Choose your AI provider: mistral, openai, or local
AI_PROVIDER=mistral
ENABLE_AI_ENHANCEMENT=True

# Mistral AI (Recommended - flexible and cost-effective)
MISTRAL_API_KEY=your_mistral_api_key_here

# OpenAI (Alternative provider)
OPENAI_API_KEY=your_openai_api_key_here

# Local LLM (Ollama, LM Studio, etc.)
LOCAL_LLM_URL=http://localhost:11434/v1

# AI Model Settings
AI_MODEL=mistral-medium
AI_TEMPERATURE=0.7
MAX_TOKENS=2000

# Database Configuration
# For development, SQLite is used by default
DATABASE_URL=sqlite:///./isohelper.db
# For production, use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost/isohelper

# Document Storage
DOCUMENTS_PATH=./generated_documents
TEMPLATES_PATH=./templates

# MarkItDown Configuration
ENABLE_MARKITDOWN=True
OUTPUT_FORMATS=["pdf", "docx", "html"]

# Logging
LOG_LEVEL=INFO
