@pytest.fixture
def iso9001_standard(test_db: Session) -> ISOStandard:
    """
    Create ISO 9001 standard in test database.
    """
    standard = ISOStandard(
        code="ISO9001",
        title="Quality Management Systems",
        version="2015",
        description="Quality management system requirements"
    )
    test_db.add(standard)
    test_db.commit()
    test_db.refresh(standard)
    
    return standard


@pytest.fixture
def multiple_iso_standards(test_db: Session) -> list[ISOStandard]:
    """
    Create multiple ISO standards for testing.
    """
    standards_data = [
        {"code": "ISO9001", "title": "Quality Management Systems", "version": "2015"},
        {"code": "ISO14001", "title": "Environmental Management", "version": "2015"},
        {"code": "ISO27001", "title": "Information Security Management", "version": "2022"},
    ]
    
    standards = []
    for data in standards_data:
        standard = ISOStandard(**data)
        test_db.add(standard)
        standards.append(standard)
    
    test_db.commit()
    for std in standards:
        test_db.refresh(std)
    
    return standards


