@pytest.fixture
def test_user(test_db: Session) -> User:
    """
    Create a test user in the database.
    Returns user instance with known credentials.
    """
    user_data = {
        "email": "test@example.com",
        "password": "Test123!@#",
        "full_name": "Test User"
    }
    
    user = AuthService.create_user(
        db=test_db,
        email=user_data["email"],
        password=user_data["password"],
        full_name=user_data["full_name"],
        role=UserRole.USER
    )
    
    # Store original password for later use
    user._test_password = user_data["password"]
    
    return user


@pytest.fixture
def admin_user(test_db: Session) -> User:
    """
    Create an admin user in the database.
    """
    admin_data = {
        "email": "admin@example.com",
        "password": "Admin123!@#",
        "full_name": "Admin User"
    }
    
    user = AuthService.create_user(
        db=test_db,
        email=admin_data["email"],
        password=admin_data["password"],
        full_name=admin_data["full_name"],
        role=UserRole.ADMIN
    )
    
    user._test_password = admin_data["password"]
    
    return user


@pytest.fixture
def auth_tokens(test_user: User, test_db: Session) -> Dict[str, str]:
    """
    Generate authentication tokens for test user.
    Returns dict with access_token and refresh_token.
    """
    access_token = AuthService.create_access_token(
        data={"user_id": test_user.id, "email": test_user.email, "role": test_user.role}
    )
    refresh_token = AuthService.create_refresh_token(test_db, test_user.id)
    
    return {
        "access_token": access_token,
        "refresh_token": refresh_token
    }


@pytest.fixture
def admin_tokens(admin_user: User, test_db: Session) -> Dict[str, str]:
    """
    Generate authentication tokens for admin user.
    """
    access_token = AuthService.create_access_token(
        data={"user_id": admin_user.id, "email": admin_user.email, "role": admin_user.role}
    )
    refresh_token = AuthService.create_refresh_token(test_db, admin_user.id)
    
    return {
        "access_token": access_token,
        "refresh_token": refresh_token
    }


@pytest.fixture
def auth_headers(auth_tokens: Dict[str, str]) -> Dict[str, str]:
    """
    Create authorization headers for authenticated requests.
    """
    return {
        "Authorization": f"Bearer {auth_tokens['access_token']}",
        "Content-Type": "application/json"
    }


@pytest.fixture
def admin_headers(admin_tokens: Dict[str, str]) -> Dict[str, str]:
    """
    Create authorization headers for admin requests.
    """
    return {
        "Authorization": f"Bearer {admin_tokens['access_token']}",
        "Content-Type": "application/json"
    }


# ============================================================================
# WORKSPACE FIXTURES
# ============================================================================

@pytest.fixture
def test_workspace(test_db: Session, test_user: User) -> Workspace:
    """
    Create a test workspace owned by test_user.
    """
    workspace = Workspace(
        name="Test Workspace",
        description="A workspace for testing",
        owner_id=test_user.id
    )
    test_db.add(workspace)
    test_db.commit()
    test_db.refresh(workspace)
    
    return workspace


@pytest.fixture
def multiple_workspaces(test_db: Session, test_user: User) -> list[Workspace]:
    """
    Create multiple test workspaces.
    """
    workspaces = []
    for i in range(3):
        workspace = Workspace(
            name=f"Test Workspace {i+1}",
            description=f"Test workspace number {i+1}",
            owner_id=test_user.id
        )
        test_db.add(workspace)
        workspaces.append(workspace)
    
    test_db.commit()
    for ws in workspaces:
        test_db.refresh(ws)
    
    return workspaces


